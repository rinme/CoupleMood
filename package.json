{
  "name": "couple-mood",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev": "bun --cwd client dev",
    "build": "bun --cwd client build && rm -rf dist && cp -r client/dist dist",
    "postinstall": "bun run build",
    "start": "bun server/src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "happy-dom": "^20.14.5",
    "typescript": "^5.7.3",
    "vitest": "^3.0.7"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "better-sqlite3@13.0.3": true
  }
}
